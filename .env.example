# Canonical list of environment variables. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values may reach the browser.

# Clerk — publishable key is client-safe, secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity — project id and dataset are client-safe. The read token is server-only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
